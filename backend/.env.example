PORT=4000
NODE_ENV=production

# PostgreSQL database URL provided by Render PostgreSQL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/raksha_setu

# Required for /auth/register and /auth/login. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Deployed FastAPI ML service.
ML_SERVICE_URL=https://raksha-sethu-ml.onrender.com
ML_TIMEOUT_MS=10000

# Minimum absolute dynamic-score increase that triggers a counsellor alert on
# NHAA event reprocessing (material escalation only).
ML_ESCALATION_DELTA=8

# OpenAI key for the CONVERSATIONAL ASSESSMENT ONLY. Stays server-side; it is
# never exposed to the frontend. OpenAI never computes the stress score.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Frontend origin. The application also accepts Vercel preview origins in prototype mode.
CORS_ORIGIN=https://raksha-setu-five.vercel.app
