PORT=4000
NODE_ENV=production

# Use the PostgreSQL URL provided by Render for the deployed database.
DATABASE_URL=postgres://...

# Required by /auth/register and /auth/login.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Deployed FastAPI ML service.
ML_SERVICE_URL=https://raksha-sethu-ml.onrender.com
ML_TIMEOUT_MS=10000

# Frontend origins allowed to call the backend.
CORS_ORIGIN=https://raksha-sethu-five.vercel.app,http://localhost:5173,http://localhost:3000
